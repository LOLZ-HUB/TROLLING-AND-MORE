-- =========================================================
--  FLING LOOP
-- =========================================================
local flingLoopRunning = false

TrollTab:AddToggle({
    Name = "Fling Loop (Target)",
    Default = false,
    Callback = function(Value)
        if Value and not flingLoopRunning then
            flingLoopRunning = true
            task.spawn(function()
                while flingLoopRunning do
                    local plr = getSelectedPlayer()
                    if plr then flingPlayer(plr) end
                    task.wait(0.6)
                end
            end)
        elseif not Value then
            flingLoopRunning = false
        end
    end
})

