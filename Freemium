local function getTarget()
    local val = Options.TargetPlayer and Options.TargetPlayer.Value
    if type(val) == "table" then
        for k, _ in pairs(val) do
            local p = Players:FindFirstChild(tostring(k))
            if p then return p end
        end
    end
    if type(val) == "string" and val ~= "" then
        return Players:FindFirstChild(val)
    end
    return nil
end

-- === FE FLING (Fixed to work globally) ===
local function feFlingCharacter(targetChar)
    local char = LocalPlayer.Character
    if not char or not targetChar then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if not hrp or not targetHrp or not hum then return end

    -- Save original position to return after fling
    local oldPos = hrp.CFrame
    local oldStand = hum.PlatformStand
    
    hum.PlatformStand = true
    
    -- Apply massive rotation to LocalPlayer
    local bav = Instance.new("BodyAngularVelocity")
    bav.Name = "FEFlingSpin"
    bav.AngularVelocity = Vector3.new(99999, 99999, 99999)
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.P = 1e6
    bav.Parent = hrp

    local startTime = tick()
    local flingLoop
    
    -- Teleport repeatedly into the target to ensure physical collision
    flingLoop = RunService.Stepped:Connect(function()
        if tick() - startTime > 1.5 or not targetHrp or not hrp then
            if flingLoop then flingLoop:Disconnect() end
            return
        end
        hrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 0)
    end)

    -- Cleanup and return to original spot
    task.delay(1.6, function()
        if flingLoop then flingLoop:Disconnect() end
        if bav then bav:Destroy() end
        hum.PlatformStand = oldStand
        hrp.CFrame = oldPos
        hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
        hrp.AssemblyAngularVelocity = Vector3.new(0,0,0)
    end)
end

