local function getTarget()
    local val = Options.TargetPlayer and Options.TargetPlayer.Value
    if type(val) == "table" then
        for k, _ in pairs(val) do
            local p = Players:FindFirstChild(tostring(k))
            if p then return p end
        end
        return nil
    end
    if type(val) == "string" and val ~= "" then
        return Players:FindFirstChild(val)
    end
    return nil
end

-- ==========================================================
--  FLING — FIXED
--  The trick: kill the Humanoid's state machine so it can't
--  resist. Unanchor + apply max torque spin + burst velocity.
-- ==========================================================
local function flingCharacter(char)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- 1. Override the Humanoid state so it can't auto-correct
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    hum.PlatformStand = true
    hum.AutoRotate = false
    hum.Sit = false

    -- 2. Unanchor every basepart so physics takes full control
    local unanchored = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            unanchored[part] = part.Anchored
            part.Anchored = false
        end
    end

    -- 3. Apply insane spin
    local bav = Instance.new("BodyAngularVelocity")
    bav.Name = "LolzFlingSpin"
    bav.AngularVelocity = Vector3.new(math.huge, math.huge, math.huge)
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.P = 1e6
    bav.Parent = hrp

    -- 4. Apply burst velocity in a random direction
    local bv = Instance.new("BodyVelocity")
    bv.Name = "LolzFlingVel"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(
        math.random(-800, 800),
        math.random(800, 2500),
        math.random(-800, 800)
    )
    bv.P = 1e5
    bv.Parent = hrp

    -- 5. Also spam the raw velocity for good measure
    hrp.AssemblyLinearVelocity = Vector3.new(
        math.random(-500, 500),
        math.random(1000, 2000),
        math.random(-500, 500)
    )
    hrp.AssemblyAngularVelocity = Vector3.new(
        math.random(-100, 100),
        math.random(-100, 100),
        math.random(-100, 100)
    )

    -- 6. Cleanup after 1 second
    task.delay(1, function()
        if bav and bav.Parent then bav:Destroy() end
        if bv  and bv.Parent  then bv:Destroy()  end
        if hum and hum.Parent then
            hum.PlatformStand = false
            hum.AutoRotate = true
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        for part, wasAnchored in pairs(unanchored) do
            if part and part.Parent then part.Anchored = wasAnchored end
        end
    end)
end

