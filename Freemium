-- =========================================================
--  HELPERS
-- =========================================================
local function getChar(plr)
    return plr and plr.Character
end

local function getHRP(plr)
    local char = getChar(plr)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum(plr)
    local char = getChar(plr)
    return char and char:FindFirstChildOfClass("Humanoid")
end

-- Steal network ownership of every part in a character (lets us move them)
local function takeNetwork(character)
    if not character then return end
    for _, v in ipairs(character:GetDescendants()) do
        if v:IsA("BasePart") then
            pcall(function() v:SetNetworkOwner(LocalPlayer) end)
        end
    end
end

-- Scale the local player's whole body
local function applyBodyScale(scale)
    local hum = getHum(LocalPlayer)
    if not hum then return end
    for _, name in ipairs({"BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale"}) do
        local num = hum:FindFirstChild(name)
        if num then num.Value = scale end
    end
    hum.HipHeight = 2 * scale
end

-- Scale just the head
local function applyHeadScale(scale)
    local hum = getHum(LocalPlayer)
    if not hum then return end
    local hs = hum:FindFirstChild("HeadScale")
    if hs then hs.Value = scale end
end

-- =========================================================
--  TROLL FUNCTIONS
-- =========================================================

-- FLING: spin + launch the target so physics freaks out
local function flingPlayer(plr)
    if not plr or plr == LocalPlayer then return end
    local char = getChar(plr)
    local hrp  = getHRP(plr)
    local hum  = getHum(plr)
    if not char or not hrp then return end

    if hum then pcall(function() hum.PlatformStand = true end) end

    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
            pcall(function() v:SetNetworkOwner(LocalPlayer) end)
        end
    end

    local spin = Instance.new("BodyAngularVelocity")
    spin.AngularVelocity = Vector3.new(0, 99999, 0)
    spin.MaxTorque       = Vector3.new(math.huge, math.huge, math.huge)
    spin.P               = 1e6
    spin.Parent          = hrp

    local push = Instance.new("BodyVelocity")
    push.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    push.Velocity = Vector3.new(0, 400, 0)
    push.Parent   = hrp

    task.delay(2, function()
        pcall(function() spin:Destroy() end)
        pcall(function() push:Destroy() end)
    end)
end

-- UNDERGROUND: teleport the target 500 studs below and turn off collisions
local function sendUnderground(plr)
    if not plr then return end
    local char = getChar(plr)
    local hrp  = getHRP(plr)
    if not char or not hrp then return end

    takeNetwork(char)
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end

    local pos = hrp.Position
    hrp.CFrame = CFrame.new(pos.X, pos.Y - 500, pos.Z)
end

-- GIANT / BIG HEAD on another player (client-side visual)
local function setTargetScale(plr, scale, headOnly)
    local hum = getHum(plr)
    if not hum then return end

    if headOnly then
        local hs = hum:FindFirstChild("HeadScale")
        if hs then hs.Value = scale end
        return
    end

    for _, name in ipairs({"BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale"}) do
        local num = hum:FindFirstChild(name)
        if num then num.Value = scale end
    end
    hum.HipHeight = 2 * scale
end

-- =========================================================
--  FLY SYSTEM
-- =========================================================
local flyState = {
    Active = false,
    Speed  = 60,
    BV     = nil,
    BG     = nil,
    Conn   = nil
}

local function stopFly()
    if flyState.Conn then flyState.Conn:Disconnect() flyState.Conn = nil end
    if flyState.BV then flyState.BV:Destroy() flyState.BV = nil end
    if flyState.BG then flyState.BG:Destroy() flyState.BG = nil end

    local hum = getHum(LocalPlayer)
    if hum then hum.PlatformStand = false end

    flyState.Active = false
end

local function startFly()
    local char = getChar(LocalPlayer)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    hum.PlatformStand = true

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent   = hrp

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P         = 9e4
    bg.CFrame    = hrp.CFrame
    bg.Parent    = hrp

    flyState.BV = bv
    flyState.BG = bg
    flyState.Active = true

    local cam = workspace.CurrentCamera

    flyState.Conn = RunService.RenderStepped:Connect(function()
        if not hrp or not hrp.Parent then stopFly() return end

        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end

        if dir.Magnitude > 0 then dir = dir.Unit end

        bv.Velocity = dir * flyState.Speed
        bg.CFrame   = cam.CFrame
    end)
end

-- Stop flying if we respawn
LocalPlayer.CharacterAdded:Connect(function()
    if flyState.Active then stopFly() end
end)

