-- === EXPLODE ===
local ChaosGroup = Tabs.Troll:AddGroupbox({
    Side = "Right",
    Name = "Chaos",
    IconName = "flame",
})

ChaosGroup:AddButton({
    Text = "💥 Explode Target",
    Func = function()
        local target = getTarget()
        if not target or not target.Character then
            Library:Notify({ Title = "Explode", Description = "No target.", Time = 2 })
            return
        end
        local hrp = target.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        -- Visual fire + ragdoll
        local fire = Instance.new("Fire")
        fire.Size = 15
        fire.Heat = 20
        fire.Parent = hrp
        task.delay(2, function() if fire then fire:Destroy() end end)

        local hum = target.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = true end
        hrp.Velocity = Vector3.new(0, 500, 0)
        task.delay(2, function()
            if hum and hum.Parent then hum.PlatformStand = false end
        end)

        Library:Notify({
            Title = "Explode",
            Description = target.Name .. " went boom.",
            Time = 3,
        })
    end,
    Tooltip = "Ragdolls and launches the target with fire.",
})

