TrollTab:AddSection({ Name = "Target" })

local SelectedTarget = "None"

local function playerNames()
    local list = { "None" }
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(list, plr.Name)
        end
    end
    return list
end

local PlayerDropdown
PlayerDropdown = TrollTab:AddDropdown({
    Name = "Select Player",
    Options = playerNames(),
    Default = "None",
    Callback = function(Value)
        SelectedTarget = Value
    end
})

local function getSelectedPlayer()
    if not SelectedTarget or SelectedTarget == "None" then return nil end
    return Players:FindFirstChild(SelectedTarget)
end

TrollTab:AddButton({
    Name = "Refresh Player List",
    Callback = function()
        local ok = pcall(function() PlayerDropdown:Refresh(playerNames()) end)
        if not ok then
            pcall(function() PlayerDropdown:SetOptions(playerNames()) end)
        end
    end
})

TrollTab:AddSection({ Name = "Actions" })

TrollTab:AddButton({
