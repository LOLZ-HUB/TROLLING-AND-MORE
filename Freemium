-- === Library fetch with jsDelivr fallback ===
local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local function fetch(url)
    local ok, res = pcall(game.HttpGet, game, url)
    if ok and type(res) == "string" and #res > 500 then return res end
    local mirror = url:gsub("raw%.githubusercontent%.com/deividcomsono/Obsidian/main/",
        "cdn.jsdelivr.net/gh/deividcomsono/Obsidian@main/")
    local ok2, res2 = pcall(game.HttpGet, game, mirror)
    if ok2 and type(res2) == "string" and #res2 > 500 then return res2 end
    error("[LOLZ HUB] Failed to download: " .. url)
end

