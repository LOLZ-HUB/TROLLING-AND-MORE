local function getRigType(char)
    if not char then return "Unknown" end
    if char:FindFirstChild("Humanoid") and char:FindFirstChild("UpperTorso") then
        return "R15"
    elseif char:FindFirstChild("Torso") then
        return "R6"
    end
    return "Unknown"
end

local function applyHeadScale(char, scale)
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    local rig = getRigType(char)
    local hum = char:FindFirstChildOfClass("Humanoid")

    if rig == "R15" then
        if hum then
            pcall(function() hum.HeadScale = scale end)
        end
    else
        local mesh = head:FindFirstChildOfClass("SpecialMesh")
        if not mesh then
            mesh = Instance.new("SpecialMesh")
            mesh.MeshType = Enum.MeshType.Head
            mesh.Parent = head
        end
        mesh.Scale = Vector3.new(scale, scale, scale)
    end
end

