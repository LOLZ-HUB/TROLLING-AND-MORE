local function getTarget()
    local val = Options.TargetPlayer and Options.TargetPlayer.Value
    if type(val) == "table" then
        for k, _ in pairs(val) do
            local p = Players:FindFirstChild(tostring(k))
            if p then return p end
        end
        return nil
    end
    if type(val) == "string" and val ~= "" then
        return Players:FindFirstChild(val)
    end
    return nil
end

-- === FLING ===
local function flingCharacter(char)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- Chaos fling: spin + velocity burst
    local spin = Instance.new("BodyAngularVelocity")
    spin.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    spin.AngularVelocity = Vector3.new(math.huge, math.huge, math.huge)
    spin.Parent = hrp

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(
        math.random(-500, 500),
        math.random(500, 2000),
        math.random(-500, 500)
    )
    bv.Parent = hrp

    task.delay(0.4, function()
        if spin and spin.Parent then spin:Destroy() end
        if bv and bv.Parent then bv:Destroy() end
    end)
end

