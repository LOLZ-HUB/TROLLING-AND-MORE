-- ==========================================================
--  FLY — FIXED
--  Key insight: Humanoid fights BodyMovers. Set PlatformStand
--  + Physics state so the Humanoid stops controlling the rig.
-- ==========================================================
local flyBV, flyBG, flyConn
local flyOldState = nil

local function stopFly()
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
    if flyConn then flyConn:Disconnect() flyConn = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
            if flyOldState then
                pcall(function() hum:ChangeState(flyOldState) end)
                flyOldState = nil
            end
        end
    end
end

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    stopFly()

    -- Save & override humanoid state so it stops fighting
    flyOldState = hum:GetState()
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    hum.PlatformStand = true

    -- Body movers
    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "LolzFlyBV"
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Velocity = Vector3.new(0, 0, 0)
    flyBV.P = 1250
    flyBV.Parent = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.Name = "LolzFlyBG"
    flyBG.P = 9e4
    flyBG.D = 500
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp

    -- Use RenderStepped for smoother input sampling
    flyConn = RunService.RenderStepped:Connect(function()
        if not Toggles.FlyToggle or not Toggles.FlyToggle.Value then return end
        local c = LocalPlayer.Character
        if not c then return end
        local root = c:FindFirstChild("HumanoidRootPart")
        if not root or not flyBV or not flyBG then return end

        local speed = Options.FlySpeed and Options.FlySpeed.Value or 60
        local cam = workspace.CurrentCamera
        local dir = Vector3.new(0, 0, 0)

        if UserInputService:IsKeyDown(Enum.KeyCode.W)        then dir = dir + cam.CFrame.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.S)        then dir = dir - cam.CFrame.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.A)        then dir = dir - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D)        then dir = dir + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space)    then dir = dir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)then dir = dir - Vector3.new(0, 1, 0) end

        if dir.Magnitude > 0 then dir = dir.Unit end

        flyBV.Velocity = dir * speed
        flyBG.CFrame   = cam.CFrame
    end)
end

